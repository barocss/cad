{
  "name": "barocss-cad-workspace",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @barocss/cad-studio-app dev",
    "dev:viewer": "pnpm --filter @barocss/cad-viewer-app dev",
    "dev:docs": "pnpm --filter @barocss/library-docs dev",
    "build": "pnpm --filter @barocss/cad-studio-app build",
    "build:viewer": "pnpm --filter @barocss/cad-viewer-app check:build",
    "build:docs": "pnpm --filter @barocss/library-docs build",
    "build:library": "pnpm -r run build:library",
    "type-check": "pnpm -r run type-check",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.3.1"
  },
  "pnpm": {
    "overrides": {
      "undici": "7.30.0",
      "cmdk>@radix-ui/react-primitive": "2.1.11"
    }
  }
}
