{
  "name": "@barocss/viewer",
  "version": "0.0.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "description": "Embeddable WebGPU CAD viewer with native geometry inspection and review tools",
  "repository": {"type": "git", "url": "git+https://github.com/barocss/cad.git", "directory": "packages/barocss-viewer"},
  "homepage": "https://github.com/barocss/cad/tree/main/packages/barocss-viewer#readme",
  "bugs": {"url": "https://github.com/barocss/cad/issues"},
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build:library": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/clipping-contract.test.mjs"
  },
  "dependencies": {
    "@barocss/cad": "workspace:*",
    "@barocss/cad-interop": "workspace:*",
    "@barocss/gpu": "workspace:*"
  }
}
