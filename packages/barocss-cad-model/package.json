{
  "name": "@barocss/cad-model",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Editable CAD documents, assemblies, drawings, engineering checks, and agent tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barocss/cad.git",
    "directory": "packages/barocss-cad-model"
  },
  "homepage": "https://github.com/barocss/cad/tree/main/packages/barocss-cad-model#readme",
  "bugs": {
    "url": "https://github.com/barocss/cad/issues"
  },
  "exports": {
    "./samples/*": "./samples/*",
    "./*.json": "./src/*.json",
    "./*": "./src/*.ts"
  },
  "files": [
    "src",
    "samples",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint src test",
    "type-check": "tsc --noEmit -p .",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@barocss/cad": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "@types/node": "26.6.4"
  }
}
